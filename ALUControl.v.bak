
module ALU_Control_Unit (
    input [1:0] ALUOp,         // ?? Control ????
    input [5:0] Funct,         // Instruction [5-0]
    output reg [3:0] ALU_Cont  // ????? ?? ALU ????
);

    always @(*) begin
        case (ALUOp)
            // ???? 00: ??????? Load ? Store (???? ?? ??? ???? ?????)
            2'b00: ALU_Cont = 4'b0010; // ADD
            
            // ???? 01: ????? Branch (???? ?? ????? ???? ?????? ?????)
            2'b01: ALU_Cont = 4'b0110; // SUB
            
            // ???? 10: ??????? ??? R (?? ???? ???? Funct ?????????? ??????)
            2'b10: begin
                case (Funct)
                    6'h20: ALU_Cont = 4'b0010; // ADD
                    6'h22: ALU_Cont = 4'b0110; // SUB
                    6'h24: ALU_Cont = 4'b0000; // AND
                    6'h25: ALU_Cont = 4'b0001; // OR
                    6'h2A: ALU_Cont = 4'b0111; // SLT
                    default: ALU_Cont = 4'b0000;
                endcase
            end
            
            // ???????
            default: ALU_Cont = 4'b0010;
        endcase
    end

endmodule
